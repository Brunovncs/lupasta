{
  "name": "lupasta",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": "github:Brunovncs/lupasta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test tests/unit && cargo test --no-default-features --manifest-path src-tauri/Cargo.toml",
    "test:unit": "bun test tests/unit",
    "test:rust": "cargo test --no-default-features --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "bun tests/e2e/run.ts",
    "fixture": "bun scripts/make-fixture.ts",
    "fixture:bench": "bun scripts/make-bench-fixture.ts",
    "icons": "bun scripts/make-icons.ts",
    "bench": "cargo run --release --no-default-features --manifest-path src-tauri/Cargo.toml --example bench --",
    "tauri": "tauri",
    "dev:fixture": "bun scripts/make-fixture.ts && tauri dev -- -- --root ../fixtures/visual/Users --select drcode/file-browser/temp_0.md"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.8.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.56.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}

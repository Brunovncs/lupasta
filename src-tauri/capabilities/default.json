{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: event bus plus the app's filesystem commands. No generic fs/shell plugins are exposed.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-root",
    "allow-list-directory",
    "allow-list-directories",
    "allow-get-children",
    "allow-expand-directory",
    "allow-get-file-metadata",
    "allow-search-files",
    "allow-index-status",
    "allow-start-indexing",
    "allow-reveal-path",
    "allow-open-path"
  ]
}
